#!/usr/bin/env bash

set -e

# -v/--verbose may appear anywhere in the arguments: pull it out and export
# NACELLE_VERBOSE so the lua side can switch its diagnostics on.
VERBOSE_ARGS=()
for a in "$@"; do
    case "$a" in
        --verbose) export NACELLE_VERBOSE=1 ;;
        --no-generation) export NACELLE_NO_GENERATION=1 ;;
        *) VERBOSE_ARGS+=("$a") ;;
    esac
done
set -- "${VERBOSE_ARGS[@]}"

# Install prefix. NACELLE_LIB points the CLI at another tree, so a working
# copy can be tested without repacking the nacelle package.
LIB="${NACELLE_LIB:-/usr/lib/nacelle}"
# also visible to the lua side, which resolves generators against it
export NACELLE_LIB="$LIB"

# `repower` is the same dispatch as `spin`, with NACELLE_REPOWER exported so
# the planners bypass their "already satisfied" gates. Rewritten before the
# case below so privilege checks, targets and paths are handled in one place.
ACTION=spin
if [ "$1" = "repower" ]; then
    export NACELLE_REPOWER=1
    ACTION=repower
    set -- spin "${@:2}"
fi

if [ $# -eq 0 ]; then
    set -- help
fi

case "$1" in
    spin)
        case "$2" in
            house)
                echo "Synchronizing house as $USER"
                if [ "$EUID" -eq 0 ]; then
                    echo "Please verify what's in the house before synchronizing it as root."
                    echo "The nacelle won't be responsible for the damage a house does to your system."
                    echo "Proceed with caution."
                fi
                sleep 1
                exec lua "$LIB/house-handlers/house_sync.lua" "${@:3}"
                ;;

            system)
                echo "Synchronizing system as $USER"
                sleep 1
                if [ "$EUID" -ne 0 ]; then
                    echo "The nacelle needs superuser privileges to synchronize the system."
                    exit 1
                fi
                exec lua "$LIB/sync.lua" "${@:3}"
                ;;

            "")
                echo "$ACTION needs a target: house or system."
                echo "Usage: nacelle $ACTION {house|system} [/path]"
                exit 1
                ;;

            *)
                echo "Nacelle doesn't know the '$2' category."
                echo "Run nacelle help"
                exit 1
                ;;

        esac
        ;;

    see-enabled)
        exec lua "$LIB/plugins.lua" "$@"
        ;;

    enable-generator|disable-generator)
        if [ "$EUID" -ne 0 ]; then
            echo "'$1' writes to /etc/nacelle and needs superuser privileges."
            exit 1
        fi
        exec lua "$LIB/plugins.lua" "$@"
        ;;

    see-registered)
        exec lua "$LIB/registry.lua" "$@"
        ;;

    register|unregister|load)
        if [ "$EUID" -ne 0 ]; then
            echo "'$1' writes to /etc/nacelle and needs superuser privileges."
            exit 1
        fi
        exec lua "$LIB/registry.lua" "$@"
        ;;

    help)
